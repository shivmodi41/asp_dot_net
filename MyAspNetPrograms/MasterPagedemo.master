<%@ Master Language="VB" CodeFile="MasterPagedemo.master.vb" Inherits="MasterPagedemo" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
    <style type="text/css">
        .auto-style1 {
            height: 33px;
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
    <div>
        
        
            <table style="width:100%;">
                <tr>
